# Copy to `secrets.env` (gitignored) and fill in. install.sh sources this and
# injects the values into the relevant plugin settings.

# eleven-labs plugin API key (the only plaintext secret in this config).
ELEVEN_LABS_API_KEY=

# Copilot keys are NOT here — that plugin stores them in your OS keychain,
# so they can't be captured/restored from files. Re-enter them in Copilot
# settings after install.
