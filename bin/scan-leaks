#!/usr/bin/env bash
# Scan the whole repo for internal references before they reach a public remote.
# Run manually, or wire as a pre-commit hook:
#   ln -sf ../../bin/scan-leaks .git/hooks/pre-commit
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

# "minion"/"minions" is deliberately absent: it is the cmux plugin's own command
# and directory name, so renaming it would break the plugin. What must never
# appear is anything that identifies the org, a real ticket, or a real machine.
PATTERN='gustohq|guideline-app|\bzenpayroll\b|\bGusto\b|RETIRE-[0-9]+|\bgroot\b|/Users/(emma\.hyde|emmahyde)/'

EXCLUDES=(
  --glob='!**/node_modules/**' --glob='!**/dist/**' --glob='!.git/**'
  --glob='!bin/scan-leaks' --glob='!.claude/skills.redact.pl' --glob='!.claude/skills-sync.sh'
)

hits=$(rg -n --pcre2 -i "$PATTERN" "${EXCLUDES[@]}" "$REPO" 2>/dev/null || true)

if [[ -n "$hits" ]]; then
  echo "Internal references found — this repo is public:"
  echo "$hits" | head -40
  count=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  [[ "$count" -gt 40 ]] && echo "... and $((count - 40)) more"
  exit 1
fi

echo "Leak scan clean."
