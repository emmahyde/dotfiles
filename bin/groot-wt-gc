#!/usr/bin/env python3
"""Preview or remove stale, merged worktrees and regenerable caches."""
import argparse
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

GENERATED = {"target", "node_modules", "__pycache__"}
SKIP_SCAN = GENERATED | {".git", ".venv", "venv", "vendor", "Library", ".local"}


def run(*args):
    timeout = 30 if args[0] == "git" and ("fetch" in args or "ls-remote" in args) else 120
    environment = os.environ.copy()
    environment["GIT_TERMINAL_PROMPT"] = "0"
    result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=timeout, env=environment)
    if result.returncode:
        raise RuntimeError(f"{args[0]} failed: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout


def git(path, *args):
    return run("git", "-C", str(path), *args)


def inside(path, parent):
    return path == parent or parent in path.parents


def open_paths():
    result = subprocess.run(["lsof", "-nP", "-Fn"], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=120)
    if result.returncode not in (0, 1) or not result.stdout:
        raise RuntimeError("Cannot inspect open files; refusing cleanup")
    return [Path(os.fsdecode(line[1:]).removesuffix(" (deleted)")).absolute()
            for line in result.stdout.splitlines() if line.startswith(b"n/")]


def busy(path, opened):
    return any(inside(p, path) for p in opened)


def allocated(path):
    output = run("du", "-sk", str(path))
    return int(output.split(None, 1)[0]) * 1024


def discover(roots):
    repos = {}
    errors = []
    for root in roots:
        if not root.exists():
            continue
        for directory, dirs, files in os.walk(root, followlinks=False):
            path = Path(directory)
            dirs[:] = [d for d in dirs if d not in SKIP_SCAN and not (path / d).is_symlink()]
            if len(path.relative_to(root).parts) >= 4:
                dirs[:] = []
            if (path / ".git").exists():
                try:
                    common = os.fsdecode(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")).strip()
                    repos.setdefault(common, Path(common))
                except (RuntimeError, subprocess.TimeoutExpired) as exc:
                    errors.append({"kind": "repository", "path": str(path), "action": "KEEP", "reason": str(exc)})
    return repos, errors


def worktrees(repo):
    raw = git(repo, "worktree", "list", "--porcelain", "-z")
    entries = []
    entry = {}
    for field in raw.split(b"\0"):
        if not field:
            if entry:
                entries.append(entry)
                entry = {}
            continue
        key, _, value = field.partition(b" ")
        entry[os.fsdecode(key)] = os.fsdecode(value)
    if entry:
        entries.append(entry)
    return entries


def default_base(repo):
    output = git(repo, "ls-remote", "--symref", "origin", "HEAD").decode()
    refs = [line.split("\t")[0][5:] for line in output.splitlines()
            if line.startswith("ref: refs/heads/") and line.endswith("\tHEAD")]
    if len(refs) != 1:
        raise RuntimeError("Cannot identify origin's default branch")
    branch = refs[0].removeprefix("refs/heads/")
    destination = f"refs/remotes/origin/{branch}"
    git(repo, "fetch", "--no-tags", "origin", f"+{refs[0]}:{destination}")
    return destination


def latest_activity(path):
    stat = path.stat()
    latest = max(stat.st_mtime, getattr(stat, "st_birthtime", 0))
    for directory, dirs, files in os.walk(path, followlinks=False):
        base = Path(directory)
        dirs[:] = [d for d in dirs if d not in SKIP_SCAN and not (base / d).is_symlink()]
        for name in files:
            item = base / name
            latest = max(latest, item.lstat().st_mtime)
    gitdir = Path(os.fsdecode(git(path, "rev-parse", "--absolute-git-dir")).strip())
    for item in (gitdir / "HEAD", gitdir / "index", gitdir / "logs" / "HEAD"):
        if item.exists():
            latest = max(latest, item.stat().st_mtime)
    return latest


def safety(repo, entry, base, roots, days, opened):
    path = Path(entry["worktree"])
    if path.is_symlink() or not path.is_dir():
        return "missing or symlinked worktree"
    if not any(inside(path.resolve(), root) for root in roots):
        return "outside configured roots"
    if not (path / ".git").is_file():
        return "primary checkout"
    if "locked" in entry or "prunable" in entry or "bare" in entry:
        return "locked, prunable, or bare worktree"
    if busy(path, opened):
        return "files open or process active in worktree"
    # Read activity before status: Git must not refresh the index during the audit.
    if latest_activity(path) >= time.time() - days * 86400:
        return f"activity within {days:g} days"
    status = git(path, "--no-optional-locks", "status", "--porcelain=v1", "-z",
                 "--untracked-files=all", "--ignored=matching", "--ignore-submodules=none")
    fields = iter(status.split(b"\0"))
    for field in fields:
        if not field:
            continue
        if not field.startswith(b"!! "):
            return "uncommitted or untracked work"
        ignored = os.fsdecode(field[3:]).rstrip("/")
        if ignored.split("/", 1)[0] not in GENERATED:
            return f"protected ignored file: {ignored}"
    if git(repo, "stash", "list"):
        return "repository has stashed work"
    head = git(path, "rev-parse", "HEAD").strip()
    check = subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor",
                            os.fsdecode(head), base], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check.returncode == 1:
        return "HEAD not contained in fetched default branch (including unproven squash merges)"
    if check.returncode:
        raise RuntimeError("Cannot verify merged commits")
    return None


def cache_roots(home):
    roots = [home / name for name in (".cache", ".npm/_cacache", ".bun/install/cache",
             ".omp/agent/cache", ".hermes/cache", ".cargo/registry/cache", ".gradle/caches")]
    library = home / "Library/Caches"
    if library.is_dir():
        roots.extend(library.iterdir())
    return roots


def clean_cache(path, apply, opened):
    row = {"kind": "cache", "path": str(path), "bytes": 0, "action": "KEEP"}
    if path.is_symlink():
        row["reason"] = "symlink; not followed"
    elif busy(path, opened):
        row["reason"] = "cache has open files"
    else:
        row["bytes"] = allocated(path)
        row["action"] = "REMOVE" if apply else "WOULD REMOVE"
        row["reason"] = "regenerable cache; contents will need downloading or rebuilding"
        if apply:
            if busy(path, open_paths()):
                row.update(action="KEEP", reason="cache became active")
            elif path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()
    return row


def build_roots(roots):
    for root in roots:
        for directory, dirs, files in os.walk(root, followlinks=False):
            path = Path(directory)
            dirs[:] = [d for d in dirs if d not in SKIP_SCAN and not (path / d).is_symlink()]
            if len(path.relative_to(root).parts) >= 4:
                dirs[:] = []
            if "Cargo.toml" in files:
                yield path / "target"
            if "package.json" in files:
                yield path / "node_modules"


def prune_colima(apply):
    contexts = run("docker", "context", "ls", "--format", "{{.Name}}").decode().splitlines()
    rows = []
    for context in contexts:
        if context != "colima" and not context.startswith("colima-"):
            continue
        for resource in ("image", "builder"):
            command = ["docker", "--context", context, resource, "prune", "--all", "--force"]
            row = {"kind": "colima", "path": f"{context}/{resource}",
                   "action": "WOULD REMOVE", "reason": "unused only; containers and volumes retained"}
            if apply:
                try:
                    row.update(action="REMOVE", reason=run(*command).decode().strip())
                except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
                    row.update(action="ERROR", reason=str(exc))
            rows.append(row)
    return rows


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="delete eligible worktrees and caches")
    parser.add_argument("--days", type=float, default=7, help="minimum worktree inactivity in days (default: 7)")
    parser.add_argument("--root", action="append", type=Path, help="worktree/repository discovery root; repeatable")
    parser.add_argument("--cache-root", action="append", type=Path, help="explicit regenerable cache directory; replaces defaults")
    parser.add_argument("--no-caches", action="store_true", help="inspect worktrees only")
    parser.add_argument("--no-worktrees", action="store_true", help="inspect caches only")
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    parser.add_argument("--builds", action="store_true", help="also clear Cargo target and node_modules outputs")
    parser.add_argument("--colima", action="store_true", help="also prune unused Colima images and build cache; never volumes")
    parser.add_argument("--delete-branches", action="store_true", help="after removing a worktree, try git branch -d; never force")
    args = parser.parse_args()
    if args.days < 0 or not args.days < float("inf"):
        parser.error("--days must be finite and nonnegative")
    home = Path.home()
    roots = [p.expanduser().resolve() for p in (args.root or [home / n for n in
             ("worktrees", "work", "src", "projects", "personal")])]
    rows = []
    had_errors = False
    try:
        opened = open_paths()
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    if not args.no_worktrees:
        repos, discovery_errors = discover(roots)
        rows.extend(discovery_errors)
        had_errors = bool(discovery_errors)
        for repo in repos.values():
            try:
                entries = worktrees(repo)
                primary = next((Path(e["worktree"]) for e in entries
                                if (Path(e["worktree"]) / ".git").is_dir()), None)
                if primary is None:
                    raise RuntimeError("No permanent primary checkout; refusing cleanup")
                repo = primary
                print(f"Checking {repo}", file=sys.stderr, flush=True)
                base = default_base(repo)
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
                rows.append({"kind": "repository", "path": str(repo), "action": "KEEP", "reason": str(exc)})
                had_errors = True
                continue
            for entry in entries:
                path = Path(entry["worktree"])
                row = {"kind": "worktree", "path": str(path), "bytes": 0, "action": "KEEP"}
                try:
                    reason = safety(repo, entry, base, roots, args.days, opened)
                    if reason:
                        row["reason"] = reason
                    else:
                        row.update(bytes=allocated(path), action="REMOVE" if args.apply else "WOULD REMOVE",
                                   reason=f"inactive >{args.days:g} days; clean; HEAD merged into {base}")
                        if args.apply:
                            reason = safety(repo, entry, base, roots, args.days, open_paths())
                            if reason:
                                row.update(action="KEEP", reason=f"recheck: {reason}")
                            else:
                                git(repo, "worktree", "remove", str(path))
                                branch = entry.get("branch", "").removeprefix("refs/heads/")
                                if args.delete_branches and branch:
                                    try:
                                        git(repo, "branch", "-d", "--", branch)
                                    except RuntimeError as exc:
                                        row["reason"] += f"; branch retained: {exc}"
                                        had_errors = True
                    rows.append(row)
                except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
                    row.update(action="ERROR", reason=str(exc))
                    rows.append(row)
                    had_errors = True
    if not args.no_caches or args.builds:
        caches = [] if args.no_caches else list(args.cache_root if args.cache_root is not None else cache_roots(home))
        if args.builds:
            caches.extend(build_roots(roots))
        seen = set()
        for raw in caches:
            path = Path(os.path.abspath(raw.expanduser()))
            if str(path) in seen:
                continue
            seen.add(str(path))
            if not path.exists() and not path.is_symlink():
                continue
            try:
                if path.resolve() != path and not path.is_symlink():
                    raise RuntimeError("Cache path traverses a symlink; refusing cleanup")
                if path in (Path("/"), home) or any(inside(root, path) for root in roots):
                    raise RuntimeError("Cache root contains a protected discovery root")
                if path.is_dir() and (path / ".git").exists():
                    raise RuntimeError("Cache root is a Git checkout")
                rows.append(clean_cache(path, args.apply, opened))
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
                rows.append({"kind": "cache", "path": str(path), "action": "ERROR", "reason": str(exc)})
                had_errors = True
    if args.colima:
        try:
            colima_rows = prune_colima(args.apply)
            rows.extend(colima_rows)
            had_errors = had_errors or any(row["action"] == "ERROR" for row in colima_rows)
        except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
            rows.append({"kind": "colima", "path": "docker", "action": "ERROR", "reason": str(exc)})
            had_errors = True
    total = sum(row.get("bytes", 0) for row in rows if row["action"] in ("REMOVE", "WOULD REMOVE"))
    report = {"generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
              "apply": args.apply, "estimated_bytes": total,
              "warning": "du estimates can count APFS shared extents; not guaranteed reclaimed bytes", "items": rows}
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        for row in rows:
            size = f"{row.get('bytes', 0) / 2**30:.2f} GiB"
            print(f"{row['action']:12} {size:>12} {row['path']}\n             {row['reason']}")
        print(f"\n{'Removed' if args.apply else 'Eligible'}: {total / 2**30:.2f} GiB (du estimate, not guaranteed physical space)")
        if not args.apply:
            print("Preview only. Run with --apply to delete. Branch deletion requires --delete-branches.")
    return int(had_errors)


if __name__ == "__main__":
    sys.exit(main())
